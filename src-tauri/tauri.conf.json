{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdot",
  "mainBinaryName": "mdot",
  "version": "1.0.2",
  "identifier": "com.mdot.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mdot",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "mdot",
        "compression": "lzma"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
